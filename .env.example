# Copy to .env (gitignored). Postgres 17 on kamel uses trust auth on loopback.
BB_ODDS_DSN=postgresql://drkamel@localhost:5432/bb_odds
BB_HOCKEY_DSN=postgresql://drkamel@localhost:5432/bb_hockey
BB_HOCKEY_PORT=5018
# Worker cadence (seconds)
BB_HOCKEY_PRICE_INTERVAL=60
BB_HOCKEY_SETTLE_INTERVAL=300
# Paper desk
BB_HOCKEY_AUTO_PAPER=true
BB_HOCKEY_MIN_EDGE=0.03
BB_HOCKEY_KELLY_FRACTION=0.25
BB_HOCKEY_UNIT=100
BB_HOCKEY_MAX_STAKE_UNITS=1.0
